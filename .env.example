# ==============================================================================
# CONFIGURATION OFFICIELLE — SSE GATEWAY GO
# ==============================================================================

# BUILD
GO_VERSION=1.27
BUILD_VERSION=0.0.1
BUILD_COMMIT=unknown
BUILD_DATE=unknown

SSE_IMAGE_NAME=sse_gateway
SSE_IMAGE_TAG=0.0.1
SSE_ENV_FILE=.env

# CONTENEUR DOCKER & HARDENING CIS
SSE_RESTART_POLICY=unless-stopped
SSE_CONTAINER_READ_ONLY=true
SSE_TMPFS_SIZE=16m
SSE_NO_NEW_PRIVILEGES=true

SSE_ULIMIT_NOFILE_SOFT=131072
SSE_ULIMIT_NOFILE_HARD=131072

SSE_EDGE_NETWORK_NAME=sse-edge-net
SSE_INTERNAL_NETWORK_NAME=sse-internal-net

SSE_CPU_LIMIT=2.0
SSE_MEM_LIMIT=512M
SSE_PIDS_LIMIT=2000
SSE_CPU_RESERVATION=0.2
SSE_MEM_RESERVATION=64M

SSE_HEALTHCHECK_INTERVAL=10s
SSE_HEALTHCHECK_TIMEOUT=3s
SSE_HEALTHCHECK_RETRIES=3
SSE_HEALTHCHECK_START_PERIOD=3s

# SERVICE
SSE_ENVIRONMENT=production
SSE_SERVICE_NAME=sse-gateway
SSE_INSTANCE_ID=

# HTTP
SSE_HOST_BIND_ADDRESS=0.0.0.0
SSE_HOST_PORT=8080
SSE_HTTP_LISTEN_HOST=0.0.0.0
SSE_HTTP_LISTEN_PORT=8080

SSE_HTTP_EVENTS_PATH=/v1/events
SSE_HTTP_HEALTH_PATH=/healthz
SSE_HTTP_READY_PATH=/readyz
SSE_HTTP_METRICS_PATH=/metrics

SSE_HTTP_READ_HEADER_TIMEOUT=5s
SSE_HTTP_IDLE_TIMEOUT=0s
SSE_HTTP_MAX_HEADER_BYTES=32768
SSE_HTTP_WRITE_TIMEOUT=0s

SSE_HTTP_TRUST_PROXY_HEADERS=false
SSE_HTTP_TRUSTED_PROXY_CIDRS=

# HUB & EVENT LANES
SSE_HUB_SHARDS=256
SSE_EVENT_LANES=64
SSE_EVENT_LANE_QUEUE_SIZE=1024

# CLIENT SSE & CONTRE-PRESSION
SSE_CLIENT_QUEUE_SIZE=32
SSE_CLIENT_WRITE_TIMEOUT=5s
SSE_CLIENT_SLOW_POLICY=disconnect

# LIMITES DE CAPACITÉ ET PROTECTION
SSE_LIMIT_MAX_CONNECTIONS=50000
SSE_LIMIT_MAX_CONNECTIONS_PER_USER=10
SSE_LIMIT_MAX_CONNECTIONS_PER_TENANT=0
SSE_LIMIT_MAX_TOPICS_PER_CONNECTION=64

# PROTECTION HANDSHAKES & RATE LIMITING
SSE_CONNECTION_RATE_LIMIT_ENABLED=true
SSE_CONNECTION_RATE_LIMIT_RPS=100
SSE_CONNECTION_RATE_LIMIT_BURST=200
SSE_LIMIT_MAX_PENDING_HANDSHAKES=1000
SSE_LIMIT_HANDSHAKE_TIMEOUT=5s

# HEARTBEAT GLOBAL
SSE_HEARTBEAT_ENABLED=true
SSE_HEARTBEAT_INTERVAL=20s
SSE_HEARTBEAT_PAYLOAD=: ping

# BUS D'ÉVÉNEMENTS AGNOSTIQUE (valkey_pubsub, memory)
SSE_EVENT_BUS_DRIVER=valkey_pubsub
SSE_EVENT_BUS_RECONNECT_ENABLED=true
SSE_EVENT_BUS_RECONNECT_MIN_DELAY=250ms
SSE_EVENT_BUS_RECONNECT_MAX_DELAY=30s
SSE_EVENT_BUS_RECONNECT_JITTER=true

# ADAPTER VALKEY PUB/SUB
SSE_EVENT_BUS_VALKEY_ADDRESS=valkey:6379
SSE_EVENT_BUS_VALKEY_USERNAME=
SSE_EVENT_BUS_VALKEY_PASSWORD=
SSE_EVENT_BUS_VALKEY_PASSWORD_FILE=
SSE_EVENT_BUS_VALKEY_DATABASE=0

SSE_EVENT_BUS_VALKEY_TLS_ENABLED=false
SSE_EVENT_BUS_VALKEY_TLS_SERVER_NAME=
SSE_EVENT_BUS_VALKEY_TLS_CA_FILE=
SSE_EVENT_BUS_VALKEY_TLS_CERT_FILE=
SSE_EVENT_BUS_VALKEY_TLS_KEY_FILE=
SSE_EVENT_BUS_VALKEY_TLS_INSECURE_SKIP_VERIFY=false

SSE_EVENT_BUS_VALKEY_CONNECT_TIMEOUT=3s
SSE_EVENT_BUS_VALKEY_READ_TIMEOUT=0s
SSE_EVENT_BUS_VALKEY_WRITE_TIMEOUT=3s
SSE_EVENT_BUS_VALKEY_CHANNEL_PATTERN=realtime.*

# GABARIT DE ROUTAGE
SSE_ROUTING_TOPIC_TEMPLATE=tenant:{tenant}:app:{app}:topic:{topic}

# DÉBALLAGE DE CLÉ & CRYPTO (http, mock)
SSE_CRYPTO_DRIVER=http
# TCP privé : http://hote:port — ou socket Unix : unix:///tmp/pq-crypto/pq.sock
# Le socket Unix est préférable : la DEK ne quitte jamais la machine hôte.
SSE_CRYPTO_HTTP_BASE_URL=http://pq-crypto-microservice:8080
SSE_CRYPTO_HTTP_UNWRAP_PATH=/unwrap-key
SSE_CRYPTO_HTTP_HEALTH_PATH=/health
SSE_CRYPTO_MAX_PAYLOAD_BYTES=5242880
# Transport application/octet-stream (format binaire V2 du go-pqc-gateway) plutôt que
# JSON+Base64 : ~25 % d'octets en moins et DEK reçue en octets bruts, effaçables in situ.
SSE_CRYPTO_HTTP_BINARY_MODE=true

SSE_CRYPTO_HTTP_CONNECT_TIMEOUT=1s
SSE_CRYPTO_HTTP_REQUEST_TIMEOUT=3s
SSE_CRYPTO_HTTP_MAX_IDLE_CONNS=256
SSE_CRYPTO_HTTP_MAX_IDLE_CONNS_PER_HOST=256
SSE_CRYPTO_HTTP_IDLE_CONN_TIMEOUT=90s

SSE_CRYPTO_HTTP_AUTH_MODE=none
SSE_CRYPTO_HTTP_BEARER_TOKEN=
SSE_CRYPTO_HTTP_BEARER_TOKEN_FILE=
SSE_CRYPTO_HTTP_BASIC_USERNAME=
SSE_CRYPTO_HTTP_BASIC_PASSWORD=
SSE_CRYPTO_HTTP_BASIC_PASSWORD_FILE=

SSE_CRYPTO_HTTP_TLS_ENABLED=false
SSE_CRYPTO_HTTP_TLS_SERVER_NAME=
SSE_CRYPTO_HTTP_TLS_CA_FILE=
SSE_CRYPTO_HTTP_TLS_CERT_FILE=
SSE_CRYPTO_HTTP_TLS_KEY_FILE=
SSE_CRYPTO_HTTP_TLS_INSECURE_SKIP_VERIFY=false

SSE_CRYPTO_PAYLOAD_CIPHER=AES-256-GCM
SSE_CRYPTO_AAD_ENABLED=true
SSE_CRYPTO_AAD_TEMPLATE={tenant_id}|{app_id}|{topic_id}|{event_id}|{version}

# VALIDATION DES CAPABILITIES (jwt, mock)
SSE_AUTH_DRIVER=jwt
SSE_AUTH_JWT_ALGORITHM=EdDSA
SSE_AUTH_JWT_AUDIENCE=sse-gateway
SSE_AUTH_JWT_ISSUER=
SSE_AUTH_JWT_PUBLIC_KEY_FILE=
SSE_AUTH_JWT_PUBLIC_KEY=
SSE_AUTH_JWT_SECRET_KEY=
SSE_AUTH_JWT_CLOCK_SKEW=30s
SSE_AUTH_JWT_REQUIRE_EXP=true
SSE_AUTH_JWT_REQUIRE_AUD=true
SSE_AUTH_JWT_REQUIRE_ISS=false
SSE_AUTH_QUERY_PARAMETER=ticket
SSE_AUTH_INVALIDATION_EVENT_TYPE=auth.invalidate

# LOGGING STRUCTURÉ
SSE_LOG_LEVEL=info
SSE_LOG_FORMAT=json
SSE_LOG_INCLUDE_SOURCE=false
SSE_LOG_REDACT_QUERY_STRING=true

# OBSERVABILITÉ & SANTÉ
SSE_METRICS_ENABLED=true
SSE_METRICS_PATH=/metrics
SSE_HEALTH_ENABLED=true
SSE_READY_ENABLED=true
SSE_READY_REQUIRE_EVENT_BUS=true
SSE_READY_REQUIRE_CRYPTO=true

# ARRÊT GRACIEUX
SSE_SHUTDOWN_GRACE_PERIOD=30s
SSE_SHUTDOWN_STOP_ACCEPTING_FIRST=true
